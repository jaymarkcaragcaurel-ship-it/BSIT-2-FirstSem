public class Nurse {
    private int nurseId;
    private String name;
    private String department;
    private int yearsOfExperience;

    public Nurse(int nurseId, String name, String department, int yearsOfExperience) {
        this.nurseId = nurseId;
        this.name = name;
        this.department = department;
        this.yearsOfExperience = yearsOfExperience;
    }

    public void displayInfo() {
        System.out.println("Nurse ID: " + nurseId);
        System.out.println("Name: " + name);
        System.out.println("Department: " + department);
        System.out.println("Years of Experience: " + yearsOfExperience);
    }

    public void recordAssistedPatients(int patients) {
        if (patients >= 0) {
            System.out.println("Nurse " + name + " assisted " + patients + " patients.");
        } else {
            System.out.println("Error: Number of patients cannot be negative.");
        }
    }

    public int getNurseId() {
        return nurseId;
    }

    public String getName() {
        return name;
    }
}
